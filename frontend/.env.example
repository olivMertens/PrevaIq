# =============================================================================
# WorkbenchIQ Frontend Environment Configuration (Sample)
# =============================================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local

# Backend API URL (default: http://localhost:8000)
# API_URL=http://localhost:8000

# =============================================================================
# API Authentication
# =============================================================================
# Must match the API_KEY set on the backend. The frontend proxy injects this
# as an X-API-Key header server-side — it is never exposed to the browser.
# If not set, requests are sent without an API key (backend must also be unset).
# API_KEY=your-secret-api-key-at-least-32-characters-long

# =============================================================================
# Frontend Authentication
# =============================================================================
# Hosted/production: Entra ID only; missing configuration never disables auth.
# ENTRA_TENANT_ID=your-tenant-id
# ENTRA_CLIENT_ID=your-app-registration-id
# ENTRA_CLIENT_SECRET=your-client-secret
# ACCESS_ADMIN_EMAILS=admin@example.com
# ACCESS_REQUEST_EMAIL=admin@example.com
#
# Optional password login for `npm run dev` ONLY. Disabled unless explicitly enabled.
# Production ignores this flag and AUTH_USER_* accounts.
# LOCAL_AUTH_ENABLED=true
# Add users as numbered env vars in format AUTH_USER_N=username:password.
# Without Entra or explicit local auth, development runs without authentication.
# AUTH_USER_1=demoUser1:your-strong-password-1
# AUTH_USER_2=demoUser2:your-strong-password-2
# Admin accounts (bypass concurrent session limit):
# AUTH_USER_ADMIN=devAdmin:your-strong-admin-password

# Brand baked in at build time (only PrevaIQ is defined in src/lib/brand.ts)
# NEXT_PUBLIC_BRAND_NAME=PrevaIQ

# Secret used to sign session tokens (change from default in production!)
# AUTH_SECRET=generate-a-random-64-char-hex-string
