        </mxCell>
        <mxCell id="email" value="Azure Communication Services&#10;Request + approval email&#10;Managed identity / Azure domain&#10;Accepted != delivered" style="rounded=0;fillColor=#EFFAF8;strokeColor=#13867C;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="935" y="320" width="220" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="admin" value="Administrator&#10;Email + authenticated dashboard&#10;Review / approve / refuse&#10;Requests survive email failures" style="rounded=0;fillColor=#F5F7FA;strokeColor=#8A97A6;" vertex="1" parent="1">
          <mxGeometry x="1235" y="320" width="230" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="Entra/consent failures before callback cannot create a verified request.&#10;Personal and unrelated tenant accounts are rejected.&#10;Administration is explicitly allowlisted; approval grants user access only.&#10;Approved applicant receives a login email; administrator is copied.&#10;Manual email remains the fallback." style="text;fontSize=14;fontColor=#4A5868;" vertex="1" parent="1">
          <mxGeometry x="35" y="300" width="820" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="e1" style="exitX=1;exitY=0.5;entryX=0;entryY=0.5;" source="colleague" target="entra" edge="1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="exitX=1;exitY=0.5;entryX=0;entryY=0.5;" source="entra" target="frontend" edge="1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
