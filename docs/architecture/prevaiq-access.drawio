<mxfile host="PrevaIQ" type="device">
  <diagram id="prevaiq-access" name="Colleague access">
    <mxGraphModel page="1" pageWidth="1500" pageHeight="470" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="PrevaIQ - Microsoft and technical demo access / administrator approval" style="text;fontSize=22;fontColor=#17395C;" vertex="1" parent="1">
          <mxGeometry x="35" y="20" width="1430" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="colleague" value="Microsoft / technical user&#10;Corporate or sandbox account" style="rounded=0;fillColor=#F5F7FA;strokeColor=#8A97A6;" vertex="1" parent="1">
          <mxGeometry x="35" y="110" width="220" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="entra" value="Microsoft Entra ID&#10;Dedicated organizational app&#10;Verified tenant allowlist" style="rounded=0;fillColor=#F1F4FA;strokeColor=#17395C;" vertex="1" parent="1">
          <mxGeometry x="335" y="110" width="220" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="frontend" value="Next.js callback&#10;State / issuer / audience / nonce&#10;Admin list / user approval" style="rounded=0;fillColor=#EFFAF8;strokeColor=#13867C;" vertex="1" parent="1">
          <mxGeometry x="635" y="110" width="220" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="api" value="FastAPI access requests&#10;Persist before email submission&#10;Bounded send, no duplicate mail" style="rounded=0;fillColor=#EFFAF8;strokeColor=#13867C;" vertex="1" parent="1">
          <mxGeometry x="935" y="110" width="220" height="90" as="geometry"/>
        </mxCell>
