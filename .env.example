# =============================================================================
# API Authentication
# =============================================================================
# Set a strong API key (min 32 chars) to protect backend endpoints.
# The same key must be set for both the backend and the frontend proxy.
# If not set, endpoints are unprotected (development mode).
# API_KEY=your-secret-api-key-at-least-32-characters-long

# Frontend Entra sign-in: organizational authority and explicit verified tenant allowlist.
# ENTRA_TENANT_ID=organizations
# ENTRA_ALLOWED_TENANT_IDS=<verified-corporate-tenant-id>,<optional-verified-sandbox-tenant-id>
# ENTRA_CLIENT_ID=<dedicated-registration-client-id>
# ENTRA_CLIENT_SECRET=<use-Key-Vault-in-Azure>
# ACCESS_ADMIN_EMAILS=<explicit-administrator-email>,<optional-technical-administrator-upn>

# Backend ACS Email notifications (managed identity; no mailbox password or service key).
# ACCESS_EMAIL_ENDPOINT=https://<dedicated-acs-host>.communication.azure.com
# ACCESS_EMAIL_SENDER=DoNotReply@<azure-managed-sender-domain>
# ACCESS_REQUEST_EMAIL=<administrator-email>
# ACCESS_ADMIN_URL=https://<frontend-host>/admin

# Azure Content Understanding Configuration
# Use Azure AD authentication (recommended for direct Cognitive Services access)
AZURE_CONTENT_UNDERSTANDING_USE_AZURE_AD=true
AZURE_CONTENT_UNDERSTANDING_ENDPOINT=https://your-resource.cognitiveservices.azure.com
# API key only needed if not using Azure AD (or if using APIM)
# AZURE_CONTENT_UNDERSTANDING_API_KEY=your-api-key

# Optional: override default analyzer and API version
AZURE_CONTENT_UNDERSTANDING_ANALYZER_ID=prebuilt-documentSearch
AZURE_CONTENT_UNDERSTANDING_API_VERSION=2025-11-01
# Analyzer model aliases are separate from the application chat deployment.
AZURE_CONTENT_UNDERSTANDING_COMPLETION_DEPLOYMENT=gpt-5.4-mini
AZURE_CONTENT_UNDERSTANDING_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Optional MarkItDown conversion path for Office/email/text formats and CU-backed Markdown.
MARKITDOWN_ENABLED=true
MARKITDOWN_MODE=local
MARKITDOWN_USE_CONTENT_UNDERSTANDING=false
MARKITDOWN_PREFERRED_EXTENSIONS=.doc,.xls,.ppt,.odt,.ods,.odp,.eml,.msg,.csv,.json,.xml,.html,.htm,.md,.txt

# Controlled orchestration budgets (0 disables a cap)
# EXTRACTION_BUDGET_SECONDS=900
# ANALYSIS_BUDGET_SECONDS=900
# ANALYSIS_TOKEN_BUDGET=400000
# MAX_REEXTRACTIONS=3
# REEXTRACTION_QUALITY_THRESHOLD=50
# REVIEW_CONFIDENCE_THRESHOLD=0.6

# Microsoft Agent Framework API: responses (default) or chat_completions (rollback)
# AGENTS_OPENAI_API=responses
# Foundry project endpoint (Agent Service only — not the Azure OpenAI endpoint)
# FOUNDRY_PROJECT_ENDPOINT=

# Observability: Application Insights via OpenTelemetry (unset = telemetry disabled).
# LOG_LEVEL=DEBUG adds agent, workflow-step and App Insights connection debug logs.
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=https://...
# LOG_LEVEL=INFO

# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-openai.openai.azure.com
AZURE_OPENAI_API_KEY=your-openai-key
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5.4-mini
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_MODEL_NAME=gpt-5.4-mini
AZURE_OPENAI_REASONING_EFFORT=low
AZURE_OPENAI_CHAT_REASONING_EFFORT=none

# Chat-specific model for Ask IQ feature.
# If not set, falls back to main deployment above
# AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=
# AZURE_OPENAI_CHAT_MODEL_NAME=

# Low-cost background model for labels, dossier titles, and classification
AZURE_OPENAI_NANO_DEPLOYMENT_NAME=gpt-5.4-nano
AZURE_OPENAI_NANO_MODEL_NAME=gpt-5.4-nano

# Application Storage Configuration
# STORAGE_BACKEND options: "azure_blob" (default) or "local"
STORAGE_BACKEND=azure_blob

# Local storage configuration (used when STORAGE_BACKEND=local)
UW_APP_STORAGE_ROOT=data


# Azure Blob Storage configuration (used when STORAGE_BACKEND=azure_blob)
#
# AZURE_STORAGE_AUTH_MODE controls which auth method is used (no fallback):
#   "default" - use DefaultAzureCredential only (recommended)
#   "key"     - use account name + key only
AZURE_STORAGE_AUTH_MODE=default

# Account name is required for DAC and key auth
AZURE_STORAGE_ACCOUNT_NAME=mystorageaccount

# Account key — only needed when not using managed identity / DAC
# AZURE_STORAGE_ACCOUNT_KEY=abc123...

AZURE_STORAGE_CONTAINER_NAME=workbenchiq-data

# Container auto-creation (default: false).
# Set to true only in dev/migration scenarios where the identity has create perms.
# In production, pre-create the container and assign "Storage Blob Data Contributor".
AZURE_STORAGE_ALLOW_CREATE_CONTAINER=false

# Default timeout and retry settings that can be overridden
# AZURE_STORAGE_TIMEOUT_SECONDS=30
# AZURE_STORAGE_RETRY_TOTAL=3

# Bing Grounding for Property Deep Dive (optional)
# Enables live web search for real estate market data in mortgage property analysis
# Create via: az deployment group create --template-file scripts/bing-grounding-arm.json
BING_SEARCH_API_KEY=your-bing-grounding-api-key

# Azure OpenAI Responses API endpoint for Bing-grounded web search (optional)
# Must be an AIServices-kind resource that supports the Responses API with web_search_preview
# If not set, property deep dive falls back to Chat Completions (LLM training knowledge)
AZURE_RESPONSES_API_ENDPOINT=https://your-aiservices-resource.cognitiveservices.azure.com

# Microsoft Web IQ remote MCP (chat tools webiq_web / webiq_news / webiq_browse)
# Local dev only. In Azure the key lives in Key Vault (infra/set-webiq-secret.ps1).
# WEBIQ_API_KEY=
# WEBIQ_MCP_URL=https://api.microsoft.ai/v3/mcp

# =============================================================================
# Souscr'IA MCP Connector (live front-office context — read-only)
# =============================================================================
# Reads live lead context (security/compliance alerts, fraud-suspicion signals,
# client card) from the Souscr'IA front-office MCP server for dossiers whose
# external_reference is a Souscr'IA thread id (prefix "t-"). Off unless a base URL
# AND a credential (token OR secret) are set. See docs/souscria-mcp-connector.md.
# Base URL only (the /scout/mcp transport path is appended automatically).
# SOUSCRIA_MCP_URL=http://localhost:8090
# SOUSCRIA_MCP_PATH=/scout/mcp
# Preferred: a pre-minted read-only Bearer token (role=service).
# SOUSCRIA_SCOUT_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Dev alternative: shared HS256 secret used to mint a service token locally.
# NEVER commit a real secret — this is read from the environment only.
# SOUSCRIA_JWT_SECRET=change-me-shared-hs256-secret
# SOUSCRIA_MCP_TIMEOUT_SECONDS=10
